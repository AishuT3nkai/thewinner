# FILE #2 — Salin jadi ".env", lalu ganti semua nilai YOUR_... Jangan pernah commit ".env".

# [WEBSITE + LAPTOP] Kunci rahasia website <-> layanan Excel. 32+ karakter acak. NILAINYA HARUS SAMA di dua tempat.
EXCEL_SERVICE_SECRET=YOUR_EXCEL_SERVICE_SECRET

# [WEBSITE] Alamat website tanpa garis miring di akhir. Contoh: https://thewinner.example.com
SITE_URL=YOUR_WEBSITE_URL
# [WEBSITE] 32+ karakter acak untuk menandatangani cookie login
SESSION_SECRET=YOUR_SESSION_SECRET
# [WEBSITE] Discord Developer Portal > OAuth2 > Client ID
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
# [WEBSITE] Discord Developer Portal > OAuth2 > Client Secret
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET
# [WEBSITE] ID server Discord kamu (angka)
DISCORD_GUILD_ID=YOUR_DISCORD_SERVER_ID
# [WEBSITE] Alamat layanan Excel di laptop. Contoh: https://laptop.tailnet.ts.net
EXCEL_SERVICE_URL=YOUR_EXCEL_SERVICE_URL
# [WEBSITE] Nama kamu/tim, tampil di halaman Privacy dan Terms
OPERATOR_NAME=YOUR_NAME_OR_TEAM
# [WEBSITE] Kontak support (email atau akun Discord), tampil di Support, Privacy, Terms
SUPPORT_CONTACT=YOUR_SUPPORT_CONTACT
# [WEBSITE] Port lokal (opsional)
PORT=3000

# [LAPTOP, opsional] Lokasi file Excel dan port layanan
EXCEL_FILE=./data/thewinner.xlsx
EXCEL_PORT=4000
